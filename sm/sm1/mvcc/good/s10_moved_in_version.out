# s10 -- a moved-in version, a live sealed version: a reader sees
# it as any version, and a write goes on over it.
#
# S seals R1, as the Column Store's seal moves a row into a row
# group; E then moves it back in, unchanged, as elimination puts
# a row of an RG into the delta store (COLSTORE2.md §6.8). E
# moves R2 in too, a key with no version, as for a row of a bulk
# load. T1's snapshot is older than both, but the rows' own
# commits are older than T1: no conflict. T1 updates R1 and
# deletes R2 over the moved-in versions, and an insert over one
# is a duplicate. T2, after E, reads both.


== pairing RR/RR == T1=RR T2=RR S=RC E=RC
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@2 check last T1 0 -> satisfied
@3 S begin -> ok
@4 S seal R1 -> ok
@5 S commit -> ok
@6 E begin -> ok
@7 E movein R1 0 -> ok
@8 E movein R2 7 -> ok
@9 E commit -> ok
@10 T2 begin -> ok
@11 T2 read R1 -> 0
@11 check last T2 0 -> satisfied
@12 T2 read R2 -> 7
@12 check last T2 7 -> satisfied
@13 T2 commit -> ok
@14 T1 read R1 -> 0
@14 check last T1 0 -> satisfied
@15 T1 insert R1 9 -> dupkey
@15 check last T1 dupkey -> satisfied
@16 T1 write R1 1 -> ok
@16 check last T1 ok -> satisfied
@17 T1 delete R2 -> ok
@17 check last T1 ok -> satisfied
@18 T1 commit -> ok
@19 check committed S E T2 T1 -> satisfied
@19 check row R1 1 -> satisfied
@19 check row R2 - -> satisfied
