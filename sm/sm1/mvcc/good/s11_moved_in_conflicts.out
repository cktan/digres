# s11 -- REPEATABLE READ: a moved-in version over a change that
# committed after the writer's snapshot is a conflict.
#
# T2 updates R1 after T1 began. S seals R1, and E moves it back
# in, unchanged. First-committer-wins sees through the moved-in
# version and the sealed tombstone to T2's update: T1's write
# fails with `conflict`, and a lock of R1 by T3, also older than
# T2's commit, does too.


== pairing RR/RR == T1=RR T2=RC T3=RR S=RC E=RC
@1 T1 begin -> ok
@2 T1 read R1 -> 0
@3 T3 begin -> ok
@4 T3 read R1 -> 0
@5 T2 begin -> ok
@6 T2 write R1 1 -> ok
@7 T2 commit -> ok
@8 S begin -> ok
@9 S seal R1 -> ok
@10 S commit -> ok
@11 E begin -> ok
@12 E movein R1 1 -> ok
@13 E commit -> ok
@14 T1 write R1 2 -> conflict
@14 check last T1 conflict -> satisfied
@15 T3 lock R1 exclusive -> conflict
@15 check last T3 conflict -> satisfied
@16 check committed T2 S E -> satisfied
@16 check row R1 1 -> satisfied
