 <(2,0),3>       |    28.274333882308138 |     6 |     3 | (2,0)     | (4.121320343559642,2.1213203435596424),(-0.12132034355964239,-2.1213203435596424)
 <(-1,-1),0.5>   |    0.7853981633974483 |     1 |   0.5 | (-1,-1)   | (-0.6464466094067263,-0.6464466094067263),(-1.3535533905932737,-1.3535533905932737)
 <(0,0),1e-07>   | 3.141592653589793e-14 | 2e-07 | 1e-07 | (0,0)     | (7.071067811865474e-08,7.071067811865474e-08),(-7.071067811865474e-08,-7.071067811865474e-08)
 <(NaN,0),1>     |     3.141592653589793 |     2 |     1 | (NaN,0)   | (NaN,0.7071067811865475),(NaN,-0.7071067811865475)
 <(0,0),NaN>     |                   NaN |   NaN |   NaN | (0,0)     | (NaN,NaN),(NaN,NaN)
 <(3,4),5>       |     78.53981633974483 |    10 |     5 | (3,4)     | (6.535533905932738,7.535533905932738),(-0.5355339059327373,0.4644660940672627)
 <(10,10),10>    |     314.1592653589793 |    20 |    10 | (10,10)   | (17.071067811865476,17.071067811865476),(2.9289321881345254,2.9289321881345254)
 <(0,3),1>       |     3.141592653589793 |     2 |     1 | (0,3)     | (0.7071067811865475,3.7071067811865475),(-0.7071067811865475,2.2928932188134525)
 <(2.5,2.5),0.5> |    0.7853981633974483 |     1 |   0.5 | (2.5,2.5) | (2.853553390593274,2.853553390593274),(2.146446609406726,2.146446609406726)
(13 rows)

SELECT a, circle(a) AS cr
FROM (VALUES
  (0, '(1,1),(0,0)'::box),
  (1, '(2,2),(1,1)'),
  (2, '(4,4),(-1,-1)'),
  (3, '(10,10),(5,5)'),
  (4, '(3,2),(0,0)'),
  (5, '(0,0),(0,0)'),
  (6, '(1,3),(1,3)'),
  (7, '(NaN,NaN),(NaN,NaN)')) a(ia, a) ORDER BY ia;
          a          |               cr               
---------------------+--------------------------------
 (1,1),(0,0)         | <(0.5,0.5),0.7071067811865476>
 (2,2),(1,1)         | <(1.5,1.5),0.7071067811865476>
 (4,4),(-1,-1)       | <(1.5,1.5),3.5355339059327378>
 (10,10),(5,5)       | <(7.5,7.5),3.5355339059327378>
 (3,2),(0,0)         | <(1.5,1),1.8027756377319948>
 (0,0),(0,0)         | <(0,0),0>
 (1,3),(1,3)         | <(1,3),0>
 (NaN,NaN),(NaN,NaN) | <(NaN,NaN),NaN>
(8 rows)

SELECT a, b, a ~= b AS same, a && b AS ov, a &< b AS ol, a << b AS l, a >> b AS r, a &> b AS or, a <@ b AS cd, a @> b AS c, a <<| b AS bl, a |>> b AS ab, a &<| b AS obl, a |&> b AS oab, a = b AS eq, a <> b AS ne, a < b AS lt, a > b AS gt, a <= b AS le, a >= b AS ge, a <-> b AS dist
FROM (VALUES
  (0, '<(0,0),1>'::circle),
  (1, '<(1,1),2>'),
  (2, '<(0,0),0>'),
  (3, '<(5,5),1>'),
  (4, '<(2,0),3>'),
  (5, '<(-1,-1),0.5>'),
  (6, '<(0,0),1e-7>'),
  (7, '<(NaN,0),1>'),
  (8, '<(0,0),NaN>'),
  (9, '<(3,4),5>'),
  (10, '<(10,10),10>'),
  (11, '<(0,3),1>'),
  (12, '<(2.5,2.5),0.5>')) a(ia, a) CROSS JOIN (VALUES
  (0, '<(0,0),1>'::circle),
  (1, '<(1,1),2>'),
  (2, '<(0,0),0>'),
  (3, '<(5,5),1>'),
  (4, '<(2,0),3>'),
  (5, '<(-1,-1),0.5>'),
  (6, '<(0,0),1e-7>'),
  (7, '<(NaN,0),1>'),
  (8, '<(0,0),NaN>'),
  (9, '<(3,4),5>'),
  (10, '<(10,10),10>'),
  (11, '<(0,3),1>'),
  (12, '<(2.5,2.5),0.5>')) b(ib, b) ORDER BY ia, ib;
