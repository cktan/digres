(2 rows)

drop table columnar_ctas;
begin isolation level serializable;
select count(*) from columnar_t;
psql:test/columnar.sql:119: ERROR:  could not open a table: a column store table cannot be used in a SERIALIZABLE transaction
LINE 1: select count(*) from columnar_t;
                             ^
\echo :SQLSTATE
0A000
rollback;
create temp table columnar_row (a int) with (storage = 'row');
insert into columnar_row values (1);
select * from columnar_row;
 a 
---
 1
(1 row)

create temp table columnar_bad (a int) with (storage = banana);
psql:test/columnar.sql:125: ERROR:  invalid value for option "storage": banana
HINT:  Valid values are "row" and "columnar".
create temp table columnar_child (r int references columnar_t (id));
psql:test/columnar.sql:126: ERROR:  there is no unique constraint matching given keys for referenced table "columnar_t"
drop table columnar_row;
drop table columnar_t;
drop table columnar_ref;
