WITH tz(id, t, tm) AS (VALUES (1, '12:00+00'::timetz, '12:00'::time), (2, '12:00+01', '12:00:01'), (3, '12:00-05', '11:59:59.999999'), (4, '23:59:59.999999+14', '00:00'), (5, '00:00-12', '23:59:59'), (6, '07:00+00', '07:00:00.5'), (7, '12:00+00', '12:00'), (8, '12:00+01:30:15', '06:30'))
SELECT id, t::text FROM tz ORDER BY t, id;
 id |         t          
----+--------------------
  5 | 00:00:00-12
  6 | 07:00:00+00
  1 | 12:00:00+00
  7 | 12:00:00+00
  2 | 12:00:00+01
  8 | 12:00:00+01:30:15
  3 | 12:00:00-05
  4 | 23:59:59.999999+14
(8 rows)

WITH tz(id, t, tm) AS (VALUES (1, '12:00+00'::timetz, '12:00'::time), (2, '12:00+01', '12:00:01'), (3, '12:00-05', '11:59:59.999999'), (4, '23:59:59.999999+14', '00:00'), (5, '00:00-12', '23:59:59'), (6, '07:00+00', '07:00:00.5'), (7, '12:00+00', '12:00'), (8, '12:00+01:30:15', '06:30'))
SELECT min(t)::text, max(t)::text, count(DISTINCT t), count(DISTINCT tm) FROM tz;
     min     |     max     | count | count 
-------------+-------------+-------+-------
 07:00:00+00 | 12:00:00-05 |     7 |     7
(1 row)

WITH tz(id, t, tm) AS (VALUES (1, '12:00+00'::timetz, '12:00'::time), (2, '12:00+01', '12:00:01'), (3, '12:00-05', '11:59:59.999999'), (4, '23:59:59.999999+14', '00:00'), (5, '00:00-12', '23:59:59'), (6, '07:00+00', '07:00:00.5'), (7, '12:00+00', '12:00'), (8, '12:00+01:30:15', '06:30'))
SELECT t::text, count(*) FROM tz GROUP BY t ORDER BY 1;
         t          | count 
--------------------+-------
 00:00:00-12        |     1
 07:00:00+00        |     1
 12:00:00+00        |     2
 12:00:00+01        |     1
 12:00:00+01:30:15  |     1
 12:00:00-05        |     1
 23:59:59.999999+14 |     1
(7 rows)

WITH tz(id, t, tm) AS (VALUES (1, '12:00+00'::timetz, '12:00'::time), (2, '12:00+01', '12:00:01'), (3, '12:00-05', '11:59:59.999999'), (4, '23:59:59.999999+14', '00:00'), (5, '00:00-12', '23:59:59'), (6, '07:00+00', '07:00:00.5'), (7, '12:00+00', '12:00'), (8, '12:00+01:30:15', '06:30'))
SELECT id, (t + interval '5 hours 30 minutes')::text AS p, (t - interval '13 hours')::text AS m, (t + interval '1 day 36 hours')::text AS d, (tm + interval '5 hours')::text AS tp, (tm - interval '13 hours')::text AS tm_ FROM tz ORDER BY id;
 id |         p          |         m          |         d          |       tp        |       tm_       
----+--------------------+--------------------+--------------------+-----------------+-----------------
  1 | 17:30:00+00        | 23:00:00+00        | 00:00:00+00        | 17:00:00        | 23:00:00
  2 | 17:30:00+01        | 23:00:00+01        | 00:00:00+01        | 17:00:01        | 23:00:01
  3 | 17:30:00-05        | 23:00:00-05        | 00:00:00-05        | 16:59:59.999999 | 22:59:59.999999
  4 | 05:29:59.999999+14 | 10:59:59.999999+14 | 11:59:59.999999+14 | 05:00:00        | 11:00:00
  5 | 05:30:00-12        | 11:00:00-12        | 12:00:00-12        | 04:59:59        | 10:59:59
  6 | 12:30:00+00        | 18:00:00+00        | 19:00:00+00        | 12:00:00.5      | 18:00:00.5
  7 | 17:30:00+00        | 23:00:00+00        | 00:00:00+00        | 17:00:00        | 23:00:00
  8 | 17:30:00+01:30:15  | 23:00:00+01:30:15  | 00:00:00+01:30:15  | 11:30:00        | 17:30:00
(8 rows)

SELECT t::text, t::timetz(0)::text AS p0, t::timetz(1)::text AS p1 FROM (VALUES ('12:00:00.56+01'::timetz), ('23:59:59.96-05'), ('00:00:00.04+00')) x(t);
       t        |     p0      |      p1       
----------------+-------------+---------------
 12:00:00.56+01 | 12:00:01+01 | 12:00:00.6+01
 23:59:59.96-05 | 24:00:00-05 | 24:00:00-05
 00:00:00.04+00 | 00:00:00+00 | 00:00:00+00
(3 rows)

