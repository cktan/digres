-- Verify bit and bit varying, which ty does (ty/DESIGN.md section 13), and
-- what a client reads from them.
-- 1. Text in, as binary digits and as hex, and out; the length of a bit(n).
-- 2. The order and the compares, equal and unequal lengths.
-- 3. Concatenation, substring, overlay and position.
-- 4. AND, OR, XOR and NOT, and the shifts both ways.
-- 5. get_bit, set_bit and bit_count.
-- 6. The casts with int4 and int8, and with a length.
-- 7. The hash.
-- (Errors are server.sh's: a run stops at its first.)
SELECT B'101' AS a, '0110'::bit(4) AS b, X'1F' AS c, '1'::varbit AS d, ''::varbit AS e, B'10101010101010101' AS f, x'abc'::bit(12) AS g, length(B'10101') AS h, bit_length(B'10101') AS i, octet_length(B'10101') AS j, '101'::bit varying(5) AS k;
  a  |  b   |    c     | d | e |         f         |      g       | h | i | j |  k  
-----+------+----------+---+---+-------------------+--------------+---+---+---+-----
 101 | 0110 | 00011111 | 1 |   | 10101010101010101 | 101010111100 | 5 | 5 | 1 | 101
(1 row)

SELECT B'101' < B'11' AS a, B'101' < B'1010' AS b, B'1' = B'1' AS c, B'1' = B'10' AS d, B'0' < B'00' AS e, B'110' <> B'100' AS f, bitcmp(B'11', B'101') AS g, bitcmp(B'1', B'1') AS h, B'' < B'0' AS i;
 a | b | c | d | e | f | g  | h | i 
---+---+---+---+---+---+----+---+---
 t | t | t | f | t | t | 32 | 0 | t
(1 row)

SELECT b FROM (VALUES (B'1'), (B'0'), (B'10'), (B'01'), (B''), (B'11111111'), (B'111111110'), (B'0000000000')) v(b) ORDER BY b;
     b      
------------
 
 0
 0000000000
 01
 1
 10
 11111111
 111111110
(8 rows)

SELECT B'101' || B'11' AS a, B'' || B'1' AS b, B'10101010' || B'1' AS c, B'1' || B'0101010101' AS d, '' || B'1'::bit(1) AS e, B'1111' || B'' AS f;
   a   | b |     c     |      d      | e |  f   
-------+---+-----------+-------------+---+------
 10111 | 1 | 101010101 | 10101010101 | 1 | 1111
(1 row)

SELECT substring(B'1010101010' FROM 3) AS a, substring(B'1010101010' FROM 3 FOR 4) AS b, substring(B'1010101010' FROM -2 FOR 5) AS c, substring(B'1010101010' FROM 9 FOR 100) AS d, substring(B'1010101010' FROM 11) AS e, substring(B'1010101010' FROM 1 FOR 0) AS f, substring(B'101' FROM 2 FOR 2147483647) AS g;
    a     |  b   | c  | d  | e | f | g  
----------+------+----+----+---+---+----
 10101010 | 1010 | 10 | 10 |   |   | 01
(1 row)

SELECT overlay(B'1111111111' PLACING B'000' FROM 3 FOR 2) AS a, overlay(B'1111111111' PLACING B'000' FROM 3) AS b, overlay(B'1111' PLACING B'0' FROM 9 FOR 2) AS c, overlay(B'1111' PLACING B'0' FROM 1 FOR 0) AS d, overlay(B'1111' PLACING B'0' FROM 2 FOR -5) AS e;
      a      |     b      |   c   |   d   |   e    
-------------+------------+-------+-------+--------
 11000111111 | 1100011111 | 11110 | 01111 | 101111
(1 row)

SELECT position(B'101' IN B'0010100') AS a, position(B'111' IN B'1010') AS b, position(B'' IN B'101') AS c, position(B'1' IN B'') AS d, position(B'10' IN B'0000000010') AS e, position(B'0' IN B'0') AS f;
 a | b | c | d | e | f 
---+---+---+---+---+---
 3 | 0 | 1 | 0 | 9 | 1
(1 row)

SELECT B'1100' & B'1010' AS a, B'1100' | B'1010' AS b, B'1100' # B'1010' AS c, ~B'1100' AS d, ~B'10101' AS e, B'110011001' & B'101010101' AS f;
  a   |  b   |  c   |  d   |   e   |     f     
------+------+------+------+-------+-----------
 1000 | 1110 | 0110 | 0011 | 01010 | 100010001
(1 row)

SELECT B'1011' << 1 AS a, B'1011' >> 1 AS b, B'1011' << 3 AS c, B'1011' >> 4 AS d, B'1011' << 10 AS e, B'1011' << -1 AS f, B'1011' >> -2 AS g, B'101010101010' << 5 AS h, B'101010101010' >> 5 AS i, B'1' << 0 AS j;
  a   |  b   |  c   |  d   |  e   |  f   |  g   |      h       |      i       | j 
------+------+------+------+------+------+------+--------------+--------------+---
 0110 | 0101 | 1000 | 0000 | 0000 | 0101 | 1100 | 010101000000 | 000001010101 | 1
(1 row)

SELECT get_bit(B'1011', 0) AS a, get_bit(B'1011', 1) AS b, get_bit(B'1011', 3) AS c, set_bit(B'1011', 1, 1) AS d, set_bit(B'1011', 0, 0) AS e, set_bit(B'1011', 3, 0) AS f, bit_count(B'1011') AS g, bit_count(B'') AS h, bit_count(B'1111111111111') AS i;
 a | b | c |  d   |  e   |  f   | g | h | i  
---+---+---+------+------+------+---+---+----
 1 | 0 | 1 | 1111 | 0011 | 1010 | 3 | 0 | 13
(1 row)

SELECT 5::int4::bit(8) AS a, (-5)::int4::bit(8) AS b, 5::int4::bit(3) AS c, 5::int4::bit(2) AS d, (-1)::int4::bit(40) AS e, 255::int8::bit(10) AS f, (-2)::int8::bit(70) AS g, 5::int4::bit(1) AS h, 5::int4::bit AS i;
    a     |    b     |  c  | d  |                    e                     |     f      |                                   g                                    | h | i 
----------+----------+-----+----+------------------------------------------+------------+------------------------------------------------------------------------+---+---
 00000101 | 11111011 | 101 | 01 | 1111111111111111111111111111111111111111 | 0011111111 | 1111111111111111111111111111111111111111111111111111111111111111111110 | 1 | 1
(1 row)

SELECT B'101'::int4 AS a, B'11111111111111111111111111111111'::int4 AS b, B''::int4 AS c, B'1'::int8 AS d, B'1111111111111111111111111111111111111111111111111111111111111111'::int8 AS e, x'7fffffff'::bit(32)::int4 AS f;
 a | b  | c | d | e  |     f      
---+----+---+---+----+------------
 5 | -1 | 0 | 1 | -1 | 2147483647
(1 row)

SELECT B'101'::bit(5) AS a, B'101'::bit(2) AS b, B'101'::varbit(2) AS c, B'101'::varbit(5) AS d, B'101'::bit(3) AS e;
   a   | b  | c  |  d  |  e  
-------+----+----+-----+-----
 10100 | 10 | 10 | 101 | 101
(1 row)

