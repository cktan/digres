SELECT uuid_extract_version('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11') AS v4, uuid_extract_version('c232ab00-9414-11ec-b3c8-9f6bdeced846') AS v1, uuid_extract_version('019535d9-3df7-79fb-b466-fa907fa17f9e') AS v7, uuid_extract_version('00000000-0000-0000-0000-000000000000') IS NULL AS nil_variant;
 v4 | v1 | v7 | nil_variant 
----+----+----+-------------
  4 |  1 |  7 | t
(1 row)

SELECT uuid_extract_timestamp('c232ab00-9414-11ec-b3c8-9f6bdeced846') AT TIME ZONE 'UTC' AS v1, uuid_extract_timestamp('019535d9-3df7-79fb-b466-fa907fa17f9e') AT TIME ZONE 'UTC' AS v7, uuid_extract_timestamp('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11') IS NULL AS v4_none;
         v1          |           v7            | v4_none 
---------------------+-------------------------+---------
 2022-02-22 19:22:22 | 2025-02-24 02:46:24.503 | t
(1 row)

SELECT uuid_extract_version(gen_random_uuid()) AS v4, gen_random_uuid() <> gen_random_uuid() AS distinct_v4, uuid_extract_version(uuidv7()) AS v7, uuidv7() < uuidv7() AS ascending, abs(extract(epoch FROM clock_timestamp() - uuid_extract_timestamp(uuidv7()))) < 60 AS recent;
 v4 | distinct_v4 | v7 | ascending | recent 
----+-------------+----+-----------+--------
  4 | t           |  7 | t         | t
(1 row)

CREATE TEMP TABLE uuid_key (u uuid PRIMARY KEY, n int4);
