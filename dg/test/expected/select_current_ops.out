-- Verify CURRENT_DATE, CURRENT_TIME, LOCALTIME and their typmods, which ty
-- (ty/DESIGN.md section 19) serves from the time of the transaction in the
-- session's zone. Each is compared with now() in the same zone, so that the
-- answers do not depend on the day the test runs.
-- 1. In each zone, the date, the time and the offset are now()'s.
-- 2. A typmod rounds the time to that many digits, and not below 0.
-- 3. The values do not change in a transaction, however long it lasts, and
--    follow the zone when it is set inside the transaction.
-- 4. A time cast to timetz has the offset of the session's zone at that time
--    today, as a timestamp of today and that time has.
-- 5. A date and a timetz make the timestamptz that their offset says.
-- 6. A timetz AT TIME ZONE a zone has the offset the zone has now; an
--    abbreviation or an offset is fixed; an interval is its own offset.
SET datestyle = 'ISO, MDY';
SET timezone = 'UTC';
SELECT current_date = now()::date AS d, current_time = now()::timetz AS t, localtime = now()::time AS lt, localtimestamp = now()::timestamp AS lts, extract(timezone FROM current_time) AS tz;
 d | t | lt | lts | tz 
---+---+----+-----+----
 t | t | t  | t   |  0
(1 row)

SET timezone = 'America/New_York';
SELECT current_date = now()::date AS d, current_time = now()::timetz AS t, localtime = now()::time AS lt, localtimestamp = now()::timestamp AS lts, extract(timezone FROM current_time) = extract(timezone FROM now()) AS tz;
 d | t | lt | lts | tz 
---+---+----+-----+----
 t | t | t  | t   | t
(1 row)

SET timezone = 'Asia/Kolkata';
SELECT current_date = now()::date AS d, current_time = now()::timetz AS t, localtime = now()::time AS lt, extract(timezone FROM current_time) AS tz;
 d | t | lt |  tz   
---+---+----+-------
 t | t | t  | 19800
(1 row)

SET timezone = 'Asia/Kathmandu';
SELECT current_date = now()::date AS d, current_time = now()::timetz AS t, localtime = now()::time AS lt, extract(timezone FROM current_time) AS tz;
 d | t | lt |  tz   
---+---+----+-------
 t | t | t  | 20700
(1 row)

SET timezone = 'Pacific/Chatham';
SELECT current_date = now()::date AS d, current_time = now()::timetz AS t, localtime = now()::time AS lt, extract(timezone FROM current_time) = extract(timezone FROM now()) AS tz;
 d | t | lt | tz 
---+---+----+----
 t | t | t  | t
(1 row)

SET timezone = 'Pacific/Kiritimati';
SELECT current_date = now()::date AS d, current_time = now()::timetz AS t, localtime = now()::time AS lt, extract(timezone FROM current_time) AS tz;
 d | t | lt |  tz   
---+---+----+-------
 t | t | t  | 50400
(1 row)

SET timezone = 'UTC';
SELECT length(localtime(3)::text) <= 12 AS l3, length(localtime(0)::text) = 8 AS l0, length(current_time(0)::text) = 11 AS c0, length(current_time(1)::text) <= 13 AS c1, localtime(6) = localtime AS l6, current_time(6) = current_time AS c6;
 l3 | l0 | c0 | c1 | l6 | c6 
----+----+----+----+----+----
 t  | t  | t  | t  | t  | t
(1 row)

BEGIN;
CREATE TEMP TABLE cur AS SELECT current_date AS d, current_time::text AS t, localtime AS lt, localtimestamp AS lts, now() AS n;
SELECT pg_sleep(0.05);
 pg_sleep 
----------
 
(1 row)

SELECT d = current_date AS d, t = current_time::text AS t, lt = localtime AS lt, lts = localtimestamp AS lts, n = now() AS n FROM cur;
 d | t | lt | lts | n 
---+---+----+-----+---
 t | t | t  | t   | t
(1 row)

SET LOCAL timezone = 'Asia/Tokyo';
SELECT extract(timezone FROM current_time) AS tz, current_time = now()::timetz AS t, current_date = now()::date AS d, extract(timezone FROM now()) AS now_tz;
  tz   | t | d | now_tz 
-------+---+---+--------
 32400 | t | t |  32400
(1 row)

SET LOCAL timezone = 'America/Los_Angeles';
SELECT extract(timezone FROM current_time) = extract(timezone FROM now()) AS tz, current_time = now()::timetz AS t, (SELECT d FROM cur) = (SELECT d FROM cur) AS same;
 tz | t | same 
----+---+------
 t  | t | t
(1 row)

COMMIT;
-- A time cast to timetz takes the offset of the zone at that time today.
SELECT z, t, extract(timezone FROM t::timetz) = extract(timezone FROM (current_date + t)::timestamptz) AS ok FROM (VALUES ('UTC'), ('America/New_York'), ('Europe/London'), ('Australia/Lord_Howe'), ('Australia/Sydney'), ('Asia/Kolkata')) zs(z), (VALUES (time '00:30'), (time '01:30'), (time '02:30'), (time '03:30'), (time '12:00'), (time '23:59:59'), (time '24:00')) ts(t) WHERE set_config('timezone', z, false) = z ORDER BY z, t;
          z          |    t     | ok 
---------------------+----------+----
 America/New_York    | 00:30:00 | t
 America/New_York    | 01:30:00 | t
 America/New_York    | 02:30:00 | t
 America/New_York    | 03:30:00 | t
 America/New_York    | 12:00:00 | t
 America/New_York    | 23:59:59 | t
 America/New_York    | 24:00:00 | t
 Asia/Kolkata        | 00:30:00 | t
 Asia/Kolkata        | 01:30:00 | t
 Asia/Kolkata        | 02:30:00 | t
 Asia/Kolkata        | 03:30:00 | t
 Asia/Kolkata        | 12:00:00 | t
 Asia/Kolkata        | 23:59:59 | t
 Asia/Kolkata        | 24:00:00 | t
 Australia/Lord_Howe | 00:30:00 | t
 Australia/Lord_Howe | 01:30:00 | t
 Australia/Lord_Howe | 02:30:00 | t
 Australia/Lord_Howe | 03:30:00 | t
 Australia/Lord_Howe | 12:00:00 | t
 Australia/Lord_Howe | 23:59:59 | t
 Australia/Lord_Howe | 24:00:00 | t
 Australia/Sydney    | 00:30:00 | t
 Australia/Sydney    | 01:30:00 | t
 Australia/Sydney    | 02:30:00 | t
 Australia/Sydney    | 03:30:00 | t
 Australia/Sydney    | 12:00:00 | t
 Australia/Sydney    | 23:59:59 | t
 Australia/Sydney    | 24:00:00 | t
 Europe/London       | 00:30:00 | t
 Europe/London       | 01:30:00 | t
 Europe/London       | 02:30:00 | t
 Europe/London       | 03:30:00 | t
 Europe/London       | 12:00:00 | t
 Europe/London       | 23:59:59 | t
 Europe/London       | 24:00:00 | t
 UTC                 | 00:30:00 | t
 UTC                 | 01:30:00 | t
 UTC                 | 02:30:00 | t
 UTC                 | 03:30:00 | t
 UTC                 | 12:00:00 | t
 UTC                 | 23:59:59 | t
 UTC                 | 24:00:00 | t
(42 rows)

SET timezone = 'UTC';
-- A date and a timetz make the timestamptz that their offset says.
SELECT d + tz AS ts, (d + tz)::text AS txt FROM (VALUES (date '2024-07-04'), (date '1999-12-31'), (date '2100-02-28')) ds(d), (VALUES (timetz '12:34:56.789012+02'), (timetz '00:00:00-05:30'), (timetz '23:59:59+14')) tzs(tz) ORDER BY d, tz;
              ts               |              txt              
-------------------------------+-------------------------------
 1999-12-31 05:30:00+00        | 1999-12-31 05:30:00+00
 1999-12-31 09:59:59+00        | 1999-12-31 09:59:59+00
 1999-12-31 10:34:56.789012+00 | 1999-12-31 10:34:56.789012+00
 2024-07-04 05:30:00+00        | 2024-07-04 05:30:00+00
 2024-07-04 09:59:59+00        | 2024-07-04 09:59:59+00
 2024-07-04 10:34:56.789012+00 | 2024-07-04 10:34:56.789012+00
 2100-02-28 05:30:00+00        | 2100-02-28 05:30:00+00
 2100-02-28 09:59:59+00        | 2100-02-28 09:59:59+00
 2100-02-28 10:34:56.789012+00 | 2100-02-28 10:34:56.789012+00
(9 rows)

SELECT date 'infinity' + timetz '12:00:00+00' AS inf, date '-infinity' + timetz '12:00:00+00' AS ninf;
   inf    |   ninf    
----------+-----------
 infinity | -infinity
(1 row)

-- A timetz AT TIME ZONE a zone takes the offset the zone has now.
SELECT z, extract(timezone FROM (timetz '12:00:00+00' AT TIME ZONE z)) = extract(timezone FROM now()) AS off, (timetz '12:00:00+00' AT TIME ZONE z)::time = time '12:00' + extract(timezone FROM now()) * interval '1 second' AS tm FROM (VALUES ('America/New_York'), ('Europe/London'), ('Australia/Lord_Howe'), ('Asia/Kolkata'), ('Pacific/Chatham')) zs(z) WHERE set_config('timezone', z, false) = z ORDER BY z;
          z          | off | tm 
---------------------+-----+----
 America/New_York    | t   | t
 Asia/Kolkata        | t   | t
 Australia/Lord_Howe | t   | t
 Europe/London       | t   | t
 Pacific/Chatham     | t   | t
(5 rows)

SET timezone = 'UTC';
-- Abbreviations and offsets, which do not change with the day.
SELECT x, timetz '12:00:00+00' AT TIME ZONE x AS r FROM (VALUES ('UTC'), ('EST'), ('EDT'), ('MSK'), ('Asia/Kolkata'), ('Europe/Moscow'), ('UTC+3'), ('+03:30')) xs(x) ORDER BY x;
       x       |       r        
---------------+----------------
 +03:30        | 08:30:00-03:30
 Asia/Kolkata  | 17:30:00+05:30
 EDT           | 08:00:00-04
 EST           | 07:00:00-05
 Europe/Moscow | 15:00:00+03
 MSK           | 15:00:00+03
 UTC           | 12:00:00+00
 UTC+3         | 09:00:00-03
(8 rows)

SELECT i, timetz '12:00:00+00' AT TIME ZONE i AS r, timetz '23:30:00-05' AT TIME ZONE i AS wrap FROM (VALUES (interval '5:30'), (interval '-2 hours'), (interval '0'), (interval '14 hours')) is_(i) ORDER BY i;
     i     |       r        |      wrap      
-----------+----------------+----------------
 -02:00:00 | 10:00:00-02    | 02:30:00-02
 00:00:00  | 12:00:00+00    | 04:30:00+00
 05:30:00  | 17:30:00+05:30 | 10:00:00+05:30
 14:00:00  | 02:00:00+14    | 18:30:00+14
(4 rows)

SELECT timetz '04:05:06+02' AT LOCAL AS loc;
     loc     
-------------
 02:05:06+00
(1 row)

