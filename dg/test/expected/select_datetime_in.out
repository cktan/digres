-- The words that read the clock: the time of the transaction.
SELECT 'today'::date = current_date AS today, 'tomorrow'::date = current_date + 1 AS tomorrow, 'yesterday'::date = current_date - 1 AS yesterday, 'now'::timestamp = localtimestamp AS now_ts, 'now'::time = localtime AS now_time, 'today'::timestamp = date_trunc('day', localtimestamp) AS today_ts, 'allballs'::time AS allballs, 'epoch'::date AS epoch_d, 'epoch'::timestamp AS epoch_ts;
