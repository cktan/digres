-- Verify date_trunc of interval, which ty does (ty/DESIGN.md section 18).
-- (Errors are server.sh's: a run stops at its first, so the units that are
-- errors, week, dow, epoch and foo, are server.sh's too.)
SELECT * FROM (
SELECT 'microseconds' AS u, i::text AS v, date_trunc('microseconds', i)::text AS t FROM (VALUES ('1 year 14 months 3 days 04:05:06.789012'::interval), ('-1 year -14 months -3 days -04:05:06.789012'::interval), ('0'::interval), ('25 years 7 months 400 days 99999 hours'::interval), ('1500 years 5 months'::interval), ('-1500 years -5 months'::interval), ('0.0000005 seconds'::interval), ('3 days 23:59:59.9999995'::interval), ('infinity'::interval), ('-infinity'::interval)) b(i)
UNION ALL
SELECT 'milliseconds' AS u, i::text AS v, date_trunc('milliseconds', i)::text AS t FROM (VALUES ('1 year 14 months 3 days 04:05:06.789012'::interval), ('-1 year -14 months -3 days -04:05:06.789012'::interval), ('0'::interval), ('25 years 7 months 400 days 99999 hours'::interval), ('1500 years 5 months'::interval), ('-1500 years -5 months'::interval), ('0.0000005 seconds'::interval), ('3 days 23:59:59.9999995'::interval), ('infinity'::interval), ('-infinity'::interval)) b(i)
UNION ALL
SELECT 'second' AS u, i::text AS v, date_trunc('second', i)::text AS t FROM (VALUES ('1 year 14 months 3 days 04:05:06.789012'::interval), ('-1 year -14 months -3 days -04:05:06.789012'::interval), ('0'::interval), ('25 years 7 months 400 days 99999 hours'::interval), ('1500 years 5 months'::interval), ('-1500 years -5 months'::interval), ('0.0000005 seconds'::interval), ('3 days 23:59:59.9999995'::interval), ('infinity'::interval), ('-infinity'::interval)) b(i)
UNION ALL
SELECT 'minute' AS u, i::text AS v, date_trunc('minute', i)::text AS t FROM (VALUES ('1 year 14 months 3 days 04:05:06.789012'::interval), ('-1 year -14 months -3 days -04:05:06.789012'::interval), ('0'::interval), ('25 years 7 months 400 days 99999 hours'::interval), ('1500 years 5 months'::interval), ('-1500 years -5 months'::interval), ('0.0000005 seconds'::interval), ('3 days 23:59:59.9999995'::interval), ('infinity'::interval), ('-infinity'::interval)) b(i)
UNION ALL
SELECT 'hour' AS u, i::text AS v, date_trunc('hour', i)::text AS t FROM (VALUES ('1 year 14 months 3 days 04:05:06.789012'::interval), ('-1 year -14 months -3 days -04:05:06.789012'::interval), ('0'::interval), ('25 years 7 months 400 days 99999 hours'::interval), ('1500 years 5 months'::interval), ('-1500 years -5 months'::interval), ('0.0000005 seconds'::interval), ('3 days 23:59:59.9999995'::interval), ('infinity'::interval), ('-infinity'::interval)) b(i)
UNION ALL
SELECT 'day' AS u, i::text AS v, date_trunc('day', i)::text AS t FROM (VALUES ('1 year 14 months 3 days 04:05:06.789012'::interval), ('-1 year -14 months -3 days -04:05:06.789012'::interval), ('0'::interval), ('25 years 7 months 400 days 99999 hours'::interval), ('1500 years 5 months'::interval), ('-1500 years -5 months'::interval), ('0.0000005 seconds'::interval), ('3 days 23:59:59.9999995'::interval), ('infinity'::interval), ('-infinity'::interval)) b(i)
UNION ALL
SELECT 'month' AS u, i::text AS v, date_trunc('month', i)::text AS t FROM (VALUES ('1 year 14 months 3 days 04:05:06.789012'::interval), ('-1 year -14 months -3 days -04:05:06.789012'::interval), ('0'::interval), ('25 years 7 months 400 days 99999 hours'::interval), ('1500 years 5 months'::interval), ('-1500 years -5 months'::interval), ('0.0000005 seconds'::interval), ('3 days 23:59:59.9999995'::interval), ('infinity'::interval), ('-infinity'::interval)) b(i)
