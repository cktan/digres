SELECT 'YEAR' AS u, i::text AS v, date_trunc('YEAR', i)::text AS t FROM (VALUES ('1 year 14 months 3 days 04:05:06.789012'::interval), ('-1 year -14 months -3 days -04:05:06.789012'::interval), ('0'::interval), ('25 years 7 months 400 days 99999 hours'::interval), ('1500 years 5 months'::interval), ('-1500 years -5 months'::interval), ('0.0000005 seconds'::interval), ('3 days 23:59:59.9999995'::interval), ('infinity'::interval), ('-infinity'::interval)) b(i)
) x ORDER BY 1, 2, 3;
