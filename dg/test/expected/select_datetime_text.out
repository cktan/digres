-- Verify the text out of date, time, timestamp, timestamptz and interval,
-- which ty writes (ty/DESIGN.md section 19), in every DateStyle, DateOrder,
-- IntervalStyle and a few time zones. (The text in is the host's.)
-- (Errors are server.sh's: a run stops at its first.)
SET datestyle = 'Postgres, MDY';
SELECT d, d::text AS t FROM (VALUES ('2000-01-01'::date), ('1999-12-31'), ('2024-02-29'), ('0001-01-01'), ('0001-12-31 BC'), ('4713-11-24 BC'), ('5874897-12-31'), ('infinity'), ('-infinity'), ('1582-10-15')) v(d);
       d       |       t       
---------------+---------------
 01-01-2000    | 01-01-2000
 12-31-1999    | 12-31-1999
 02-29-2024    | 02-29-2024
 01-01-0001    | 01-01-0001
 12-31-0001 BC | 12-31-0001 BC
 11-24-4713 BC | 11-24-4713 BC
 12-31-5874897 | 12-31-5874897
 infinity      | infinity
 -infinity     | -infinity
 10-15-1582    | 10-15-1582
(10 rows)

