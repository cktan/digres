-- Verify the typmod of interval, timestamp and time, and make_interval, which
-- ty does (ty/DESIGN.md sections 18 and 19).
-- (Errors are server.sh's: a run stops at its first.)
SELECT v, v::interval(0) AS p0, v::interval(1) AS p1, v::interval(3) AS p3, v::interval(6) AS p6, v::interval second(2) AS s2, v::interval minute to second(1) AS ms1 FROM (VALUES ('1 day 2 hours 3 minutes 4.5678 seconds'::interval), ('-1 day -2 hours -3 minutes -4.5678 seconds'), ('0.0000005 seconds'), ('-0.0000005 seconds'), ('1.5 seconds'), ('-1.5 seconds'), ('2.5 seconds'), ('infinity'), ('0')) x(v);
           v            |        p0         |         p1          |          p3           |           p6           |          s2          |         ms1         
------------------------+-------------------+---------------------+-----------------------+------------------------+----------------------+---------------------
 1 day 02:03:04.5678    | 1 day 02:03:05    | 1 day 02:03:04.6    | 1 day 02:03:04.568    | 1 day 02:03:04.5678    | 1 day 02:03:04.57    | 1 day 02:03:04.6
 -1 days -02:03:04.5678 | -1 days -02:03:05 | -1 days -02:03:04.6 | -1 days -02:03:04.568 | -1 days -02:03:04.5678 | -1 days -02:03:04.57 | -1 days -02:03:04.6
 00:00:00               | 00:00:00          | 00:00:00            | 00:00:00              | 00:00:00               | 00:00:00             | 00:00:00
 00:00:00               | 00:00:00          | 00:00:00            | 00:00:00              | 00:00:00               | 00:00:00             | 00:00:00
 00:00:01.5             | 00:00:02          | 00:00:01.5          | 00:00:01.5            | 00:00:01.5             | 00:00:01.5           | 00:00:01.5
 -00:00:01.5            | -00:00:02         | -00:00:01.5         | -00:00:01.5           | -00:00:01.5            | -00:00:01.5          | -00:00:01.5
 00:00:02.5             | 00:00:03          | 00:00:02.5          | 00:00:02.5            | 00:00:02.5             | 00:00:02.5           | 00:00:02.5
 infinity               | infinity          | infinity            | infinity              | infinity               | infinity             | infinity
 00:00:00               | 00:00:00          | 00:00:00            | 00:00:00              | 00:00:00               | 00:00:00             | 00:00:00
(9 rows)

