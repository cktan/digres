 -1 years -2 mons -3 days -02:03:04.5 | -1 years  | -1 years -2 mons | -1 years -2 mons | -1 years -2 mons -3 days | -1 years -2 mons -3 days -02:00:00 | -1 years -2 mons -3 days -02:03:00 | -1 years -2 mons -3 days -02:00:00 | -1 years -2 mons -3 days -02:03:00 | -1 years -2 mons -3 days -02:03:04.5 | -1 years -2 mons -3 days -02:03:00 | -1 years -2 mons -3 days -02:03:04.5
 1 mon 40 days 100:30:30              | 00:00:00  | 1 mon            | 1 mon            | 1 mon 40 days            | 1 mon 40 days 100:00:00            | 1 mon 40 days 100:30:00            | 1 mon 40 days 100:00:00            | 1 mon 40 days 100:30:00            | 1 mon 40 days 100:30:30              | 1 mon 40 days 100:30:00            | 1 mon 40 days 100:30:30
 00:00:00                             | 00:00:00  | 00:00:00         | 00:00:00         | 00:00:00                 | 00:00:00                           | 00:00:00                           | 00:00:00                           | 00:00:00                           | 00:00:00                             | 00:00:00                           | 00:00:00
 -infinity                            | -infinity | -infinity        | -infinity        | -infinity                | -infinity                          | -infinity                          | -infinity                          | -infinity                          | -infinity                            | -infinity                          | -infinity
