SELECT make_interval(0, 0, 0, 0, 0, 0, 0) AS a, make_interval(1, 2, 3, 4, 5, 6, 7.5) AS b, make_interval(1, 0, 0, 0, 0, 0, 0) AS c, make_interval(0, 0, 2, 1, 0, 0, 0) AS d, make_interval(0, 0, 0, 0, 25, 61, 61.5) AS e, make_interval(0, 0, 0, 0, 0, 0, 0.0000005) AS f, make_interval(-1, 13, 0, 0, 0, 0, 0) AS g, make_interval(0, 0, 0, 0, 0, 0, -1.25) AS h;
