-- Verify point and box, whose operations ty does (ty/DESIGN.md section 20),
-- with the fuzzy compares, NaN and infinity.
-- 1. point: the compares, + - * /, distance and slope.
-- 2. box: construction, the position operators, area, width, height, center.
-- 3. box: intersection, distance, + - * /, and the order by area.
-- (Errors are server.sh's: a run stops at its first.)
SELECT p, q, p << q AS l, p >> q AS r, p >^ q AS a, p <^ q AS b, p ?- q AS h, p ?| q AS v, p ~= q AS eq, p <-> q AS dist, p + q AS pl, p - q AS mi, p * q AS mu, p / q AS dv, slope(p, q) AS sl FROM (VALUES ('(1,2)'::point, '(3,4)'::point), ('(1,2)', '(1,2.0000005)'), ('(1,2)', '(1.0000005,2)'), ('(0.5,0)', '(0,0.5)'), ('(-1.5,2.5)', '(2,-3)'), ('(1e10,1e10)', '(1,1)'), ('(0,0)', '(3,4)'), ('(1,1)', '(1,5)'), ('(NaN,1)', '(NaN,1)'), ('(1,2)', '(Infinity,1)'), ('(1,2)', '(1,2)')) v(p, q);
             p             |       q       | l | r | a | b | h | v | eq |         dist         |            pl             |            mi             |               mu               |                     dv                     |         sl          
---------------------------+---------------+---+---+---+---+---+---+----+----------------------+---------------------------+---------------------------+--------------------------------+--------------------------------------------+---------------------
 (1,2)                     | (3,4)         | t | f | f | t | f | f | f  |   2.8284271247461903 | (4,6)                     | (-2,-2)                   | (-5,10)                        | (0.44,0.08)                                |                   1
 (1,2)                     | (1,2.0000005) | f | f | f | f | t | t | t  | 5.00000000069889e-07 | (2,4.0000005000000005)    | (0,-5.00000000069889e-07) | (-3.000001,4.0000005000000005) | (0.9999998000000301,-9.99999600139888e-08) |            Infinity
 (1,2)                     | (1.0000005,2) | f | f | f | f | t | t | t  | 5.00000000069889e-07 | (2.0000005,4)             | (-5.00000000069889e-07,0) | (-2.9999995,4.000001)          | (0.9999998999999702,1.999999600279536e-07) |            Infinity
 (0.5,0)                   | (0,0.5)       | f | t | f | t | f | f | f  |   0.7071067811865476 | (0.5,0.5)                 | (0.5,-0.5)                | (0,0.25)                       | (0,-1)                                     |                  -1
 (-1.5,2.5)                | (2,-3)        | t | f | t | f | f | f | f  |    6.519202405202649 | (0.5,-0.5)                | (-3.5,5.5)                | (4.5,9.5)                      | (-0.8076923076923077,0.038461538461538464) | -1.5714285714285714
 (10000000000,10000000000) | (1,1)         | f | t | t | f | f | f | f  |   14142135622.316738 | (10000000001,10000000001) | (9999999999,9999999999)   | (0,20000000000)                | (10000000000,0)                            |                   1
 (0,0)                     | (3,4)         | t | f | f | t | f | f | f  |                    5 | (3,4)                     | (-3,-4)                   | (0,0)                          | (0,0)                                      |  1.3333333333333333
 (1,1)                     | (1,5)         | f | f | f | t | f | t | f  |                    4 | (2,6)                     | (0,-4)                    | (-4,6)                         | (0.23076923076923078,-0.15384615384615385) |            Infinity
 (NaN,1)                   | (NaN,1)       | f | f | f | f | t | f | t  |                  NaN | (NaN,2)                   | (NaN,0)                   | (NaN,NaN)                      | (NaN,NaN)                                  |                   0
 (1,2)                     | (Infinity,1)  | t | f | t | f | f | f | f  |             Infinity | (Infinity,3)              | (-Infinity,1)             | (Infinity,Infinity)            | (NaN,NaN)                                  |                  -0
 (1,2)                     | (1,2)         | f | f | f | f | t | t | t  |                    0 | (2,4)                     | (0,0)                     | (-3,4)                         | (1,0)                                      |            Infinity
(11 rows)

SELECT b, area(b) AS ar, width(b) AS w, height(b) AS h, center(b) AS c, diagonal(b) AS dg FROM (VALUES ('(2,2),(0,0)'::box), ('(0,0),(2,2)'), ('(1,1),(1,1)'), ('(-1,-1),(1,3)'), ('(0.5,0.5),(10,20)'), ('(3,4),(1,2)')) v(b);
