SELECT b, b + '(1,2)'::point AS pl, b - '(1,2)'::point AS mi, b * '(2,0)'::point AS mu, b / '(2,0)'::point AS dv, b * '(1,1)'::point AS mu2 FROM (VALUES ('(2,2),(0,0)'::box), ('(1,1),(-1,-1)'), ('(3,4),(1,2)')) v(b);
