-- Verify the conversions between date, time, timestamp and interval, which ty
-- does (ty/DESIGN.md section 19).
-- (Errors are server.sh's: a run stops at its first.)
SELECT d::text, d::timestamp::text AS ts, (d + time '13:45:56.789012')::text AS dt, (d + time '24:00')::text AS dt24, d::timestamp::date::text AS back FROM (VALUES ('2024-02-29'::date), ('0001-01-01'), ('4714-11-24 BC'), ('1999-12-31'), ('2000-01-01'), ('infinity'), ('-infinity')) x(d) ORDER BY d;
       d       |           ts           |              dt               |          dt24          |     back      
---------------+------------------------+-------------------------------+------------------------+---------------
 -infinity     | -infinity              | -infinity                     | -infinity              | -infinity
 0001-01-01    | 0001-01-01 00:00:00    | 0001-01-01 13:45:56.789012    | 0001-01-02 00:00:00    | 0001-01-01
 1999-12-31    | 1999-12-31 00:00:00    | 1999-12-31 13:45:56.789012    | 2000-01-01 00:00:00    | 1999-12-31
 2000-01-01    | 2000-01-01 00:00:00    | 2000-01-01 13:45:56.789012    | 2000-01-02 00:00:00    | 2000-01-01
 2024-02-29    | 2024-02-29 00:00:00    | 2024-02-29 13:45:56.789012    | 2024-03-01 00:00:00    | 2024-02-29
 4714-11-24 BC | 4714-11-24 00:00:00 BC | 4714-11-24 13:45:56.789012 BC | 4714-11-25 00:00:00 BC | 4714-11-24 BC
 infinity      | infinity               | infinity                      | infinity               | infinity
(7 rows)

SELECT t::text, t::date::text AS d, t::time::text AS tm FROM (VALUES ('2024-02-29 13:45:56.789012'::timestamp), ('0044-03-15 12:00:00.5 BC'), ('1999-12-31 23:59:59.999999'), ('2000-01-01 00:00:00'), ('1969-12-31 00:00:00.000001'), ('infinity'), ('-infinity')) x(t) ORDER BY t;
             t              |       d       |       tm        
----------------------------+---------------+-----------------
 -infinity                  | -infinity     | 
 0044-03-15 12:00:00.5 BC   | 0044-03-15 BC | 12:00:00.5
 1969-12-31 00:00:00.000001 | 1969-12-31    | 00:00:00.000001
 1999-12-31 23:59:59.999999 | 1999-12-31    | 23:59:59.999999
 2000-01-01 00:00:00        | 2000-01-01    | 00:00:00
 2024-02-29 13:45:56.789012 | 2024-02-29    | 13:45:56.789012
 infinity                   | infinity      | 
(7 rows)

SELECT i::text, i::time::text AS tm, (i::time)::interval::text AS back FROM (VALUES ('1 day 02:03:04.5'::interval), ('-2 hours'), ('0'), ('25 hours'), ('-25 hours -1 minute'), ('3 months 4 days 05:06:07'), ('-1 microsecond'), ('24:00:00')) x(i) ORDER BY i;
           i            |       tm        |      back       
------------------------+-----------------+-----------------
 -00:00:00.000001       | 23:59:59.999999 | 23:59:59.999999
 -02:00:00              | 22:00:00        | 22:00:00
 -25:01:00              | 22:59:00        | 22:59:00
 00:00:00               | 00:00:00        | 00:00:00
 1 day 02:03:04.5       | 02:03:04.5      | 02:03:04.5
 24:00:00               | 00:00:00        | 00:00:00
 25:00:00               | 01:00:00        | 01:00:00
 3 mons 4 days 05:06:07 | 05:06:07        | 05:06:07
(8 rows)

SELECT d::text, d < t AS lt, d = t AS eq, d > t AS gt, d <= t AS le, d >= t AS ge, d <> t AS ne FROM (VALUES ('2024-02-29'::date), ('2000-01-01'), ('infinity'), ('-infinity')) a(d), (VALUES ('2024-02-29 00:00:00'::timestamp), ('2024-02-29 00:00:01'), ('2023-12-31 23:59:59.999999'), ('infinity'), ('-infinity')) b(t) ORDER BY 1, 2, 3, 4;
     d      | lt | eq | gt | le | ge | ne 
------------+----+----+----+----+----+----
 -infinity  | f  | t  | f  | t  | t  | f
 -infinity  | t  | f  | f  | t  | f  | t
 -infinity  | t  | f  | f  | t  | f  | t
 -infinity  | t  | f  | f  | t  | f  | t
 -infinity  | t  | f  | f  | t  | f  | t
 2000-01-01 | f  | f  | t  | f  | t  | t
 2000-01-01 | t  | f  | f  | t  | f  | t
 2000-01-01 | t  | f  | f  | t  | f  | t
 2000-01-01 | t  | f  | f  | t  | f  | t
 2000-01-01 | t  | f  | f  | t  | f  | t
 2024-02-29 | f  | f  | t  | f  | t  | t
