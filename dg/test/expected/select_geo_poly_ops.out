 ((0,0),(2,0),(2,2),(0,2)) |   4 |                  8 | 4 | t
 [(0,0),(2,2),(4,0),(6,2)] |     |  8.485281374238571 | 4 | f
 ((10,10),(20,10),(20,20)) |  50 |  34.14213562373095 | 3 | t
 [(0,2),(4,2)]             |     |                  4 | 2 | f
(12 rows)

SELECT a, b, a + b AS pl, a - b AS mi, a * b AS mu, a <-> b AS dist, b <@ a AS on
FROM (VALUES
  (0, '[(0,0),(1,1),(2,0)]'::path),
  (1, '((0,0),(4,0),(4,4),(0,4))'),
  (2, '((0,0),(1,0),(1,1))'),
  (3, '[(1,1)]'),
  (4, '[(0,0),(3,4)]'),
  (5, '((1,1),(2,2),(3,0),(0,3))'),
  (6, '[(NaN,0),(1,1)]'),
  (7, '[(5,5),(6,5),(6,6),(5,6)]'),
  (8, '((0,0),(2,0),(2,2),(0,2))'),
  (9, '[(0,0),(2,2),(4,0),(6,2)]'),
  (10, '((10,10),(20,10),(20,20))'),
  (11, '[(0,2),(4,2)]')) a(ia, a) CROSS JOIN (VALUES
  (0, '(0,0)'::point),
  (1, '(1,1)'),
  (2, '(1,2)'),
  (3, '(-3,4)'),
  (4, '(2.5,-1.5)'),
  (5, '(10,10)'),
  (6, '(0,5)'),
  (7, '(5,0)'),
  (8, '(3,3)'),
  (9, '(2,0)'),
  (10, '(NaN,1)')) b(ib, b) ORDER BY ia, ib;
