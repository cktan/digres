SELECT a, b, a ?# b AS inter, a ?|| b AS par, a ?-| b AS perp, a = b AS eq, a <> b AS ne, a < b AS lt, a <= b AS le, a > b AS gt, a >= b AS ge, a # b AS pt, a <-> b AS dist, a ## b AS clo
FROM (VALUES
  (0, '[(0,0),(1,1)]'::lseg),
  (1, '[(0,0),(2,0)]'),
  (2, '[(0,0),(0,2)]'),
  (3, '[(1,0),(0,1)]'),
  (4, '[(0,1),(2,3)]'),
  (5, '[(1,1),(1,1)]'),
  (6, '[(-1,-1),(3,3)]'),
  (7, '[(2,2),(4,4)]'),
  (8, '[(0,3),(3,0)]'),
  (9, '[(0,0),(3,4)]'),
  (10, '[(5,5),(6,5)]'),
  (11, '[(2,-1),(2,5)]'),
  (12, '[(NaN,0),(1,1)]')) a(ia, a) CROSS JOIN (VALUES
  (0, '[(0,0),(1,1)]'::lseg),
  (1, '[(0,0),(2,0)]'),
  (2, '[(0,0),(0,2)]'),
  (3, '[(1,0),(0,1)]'),
  (4, '[(0,1),(2,3)]'),
  (5, '[(1,1),(1,1)]'),
  (6, '[(-1,-1),(3,3)]'),
  (7, '[(2,2),(4,4)]'),
  (8, '[(0,3),(3,0)]'),
  (9, '[(0,0),(3,4)]'),
  (10, '[(5,5),(6,5)]'),
  (11, '[(2,-1),(2,5)]'),
  (12, '[(NaN,0),(1,1)]')) b(ib, b) ORDER BY ia, ib;
