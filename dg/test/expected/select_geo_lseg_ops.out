  (0, '(0,0)'::point),
  (1, '(1,1)'),
  (2, '(1,2)'),
  (3, '(-3,4)'),
  (4, '(2.5,-1.5)'),
  (5, '(10,10)'),
  (6, '(0,5)'),
  (7, '(5,0)'),
  (8, '(1e-7,0)'),
  (9, '(NaN,1)'),
  (10, '(3,3)'),
  (11, '(0.5,0.5)'),
  (12, '(2,2)')) a(ia, a) CROSS JOIN (VALUES
  (0, '(0,0)'::point),
  (1, '(1,1)'),
  (2, '(1,2)'),
  (3, '(-3,4)'),
  (4, '(2.5,-1.5)'),
  (5, '(10,10)'),
  (6, '(0,5)'),
  (7, '(5,0)'),
  (8, '(1e-7,0)'),
  (9, '(NaN,1)'),
  (10, '(3,3)'),
  (11, '(0.5,0.5)'),
  (12, '(2,2)')) b(ib, b)
WHERE NOT a ~= b ORDER BY ia, ib;
